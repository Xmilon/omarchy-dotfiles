{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.
  //
  // Fields:
  //   icon        Nerd Font glyph shown in the icon column.
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Name of a shell-defined runtime row source (e.g. "fonts").
  //   aliases     alternate `omarchy menu summon <name>` routes; also searchable.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.
  //
  // Examples:
  // "personal": {"icon":"","label":"Personal"},
  // "personal.notes": {"icon":"󰎞","label":"Notes","action":"omarchy-launch-editor ~/notes"},
  // "personal.files": {"icon":"","label":"Files","action":"uwsm-app -- nautilus ~/Documents"},
  //
  // provider can only reference row sources the shell already defines (the
  // providers map in Menu.qml). Static submenus only need dotted ids.
  //
  // Example: replace the default About action by reusing the same id. Existing
  // fields are kept unless overridden.
  // "about": {"icon":"","label":"About","action":"omarchy-launch-or-focus-tui \"zsh -c 'fastfetch; read -k 1'\""},

  "update.apps": {"icon":"󰏗","label":"Applications","description":"Update installed apps and CLI tools"},
  "update.apps.discord": {"icon":"","label":"Discord","action":"~/.local/bin/omarchy-app-updates --run pkg:discord","when":"pacman -Q discord >/dev/null 2>&1"},
  "update.apps.t3code": {"icon":"","label":"T3 Code","action":"~/.local/bin/omarchy-app-updates --run pkg:t3code-bin","when":"pacman -Q t3code-bin >/dev/null 2>&1"},
  "update.apps.installed": {"icon":"󰒓","label":"All installed apps…","action":"~/.local/bin/omarchy-app-updates","description":"Automatically includes new packages, Flatpaks, shell plugins and uv tools"},
  "update.apps.packages": {"icon":"󰏖","label":"Update all packages","action":"~/.local/bin/omarchy-app-updates --run packages"},
  "update.apps.flatpak": {"icon":"","label":"Flatpak apps","action":"~/.local/bin/omarchy-app-updates --run flatpaks","when":"command -v flatpak >/dev/null"},

  // One-click app stores, under Install.
  "install.bazaar": {"icon":"󰏓","label":"App Store","description":"Flathub apps, one-click install","action":"uwsm-app -- io.github.kolunmi.Bazaar.desktop","when":"command -v bazaar >/dev/null"},
  "install.pamac": {"icon":"󰣇","label":"Pamac (AUR)","description":"Arch packages and AUR, one-click install","action":"uwsm-app -- org.manjaro.pamac.manager.desktop","when":"command -v pamac-manager >/dev/null"},

  // Restart straight into Windows once (asks for your password).
  "system.reboot-windows": {"icon":"󰖳","label":"Reboot to Windows","action":"~/.local/bin/reboot-to-windows","when":"efibootmgr | grep -q 'Windows Boot Manager'"},
}
