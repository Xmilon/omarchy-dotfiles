    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────── Uptime ──────────────────────┐"
    },
    {
      "type": "command",
      "key": "󱫐 Uptime",
      "keyColor": "magenta",
      "text": "up=$(cut -d. -f1 /proc/uptime); d=$((up/86400)); h=$((up%86400/3600)); m=$((up%3600/60)); if [ $d -gt 0 ]; then echo \"${d}d ${h}h\"; elif [ $h -gt 0 ]; then echo \"${h}h ${m}m\"; else echo \"${m}m\"; fi"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
