# Dynamic theme colors
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# Font
font-family = "JetBrainsMono Nerd Font"
font-style = Regular
font-size = 11

# Window
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
confirm-close-surface=false
resize-overlay = never
gtk-toolbar-style = flat

# Cursor styling
cursor-style = "bar"
cursor-style-blink = true

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = cursor,ssh-env

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u
# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll

# --- Personal tweaks ---
# Window
window-padding-balance = true
window-inherit-working-directory = true
unfocused-split-opacity = 0.65
split-divider-color = #584e51
background-opacity = 0.38
background-opacity-cells = true
background-blur = 30

# Behavior
copy-on-select = clipboard
mouse-hide-while-typing = true
scrollback-limit = 100000000
clipboard-paste-protection = true
cursor-style-blink = true
adjust-cell-height = 10%

# Tabs and splits (ctrl+shift keeps normal terminal shortcuts free)
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+page_down=next_tab
keybind = ctrl+page_up=previous_tab
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+arrow_up=goto_split:up
keybind = ctrl+shift+arrow_down=goto_split:down
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+f=write_scrollback_file:open
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# --- Rice ---
window-padding-x = 18
window-padding-y = 16
cursor-opacity = 0.9
bold-color = bright
font-feature = calt
font-feature = liga
# Smooth cursor trail in the cursor's colour (~/.config/ghostty/shaders)
custom-shader = ~/.config/ghostty/shaders/cursor_trail.glsl
custom-shader-animation = true

# --- Editor-style clipboard keys (no Shift needed) ---
# Ctrl+C copies when text is selected with the mouse; with nothing selected it
# still reaches the shell, so Ctrl+C keeps stopping programs.
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard

# Let the shell (ble.sh) have the selection keys: Shift+arrows, Shift+Home/End
# and Ctrl+Shift+arrows select text on the command line instead of Ghostty
# adjusting its mouse selection, scrolling, or switching tabs.
keybind = shift+arrow_left=unbind
keybind = shift+arrow_right=unbind
keybind = shift+arrow_up=unbind
keybind = shift+arrow_down=unbind
keybind = shift+home=unbind
keybind = shift+end=unbind
keybind = ctrl+shift+arrow_left=unbind
keybind = ctrl+shift+arrow_right=unbind

# No title bar of Ghostty's own: floating windows get the shared Hyprland
# title bar (hyprbars, styled in ~/.config/hypr/looknfeel.lua).
window-decoration = none

# Settings that must beat the theme go in overrides.conf. Ghostty reads
# config-file includes after this file and in order, so the theme comes first
# and overrides.conf wins.
config-file = ?"~/.config/ghostty/overrides.conf"
