#!/usr/bin/env python3
"""Stop a double-click on the empty bar from cycling its background.

Omarchy cycles the bar clear -> glassy -> opaque when you double-click an
empty spot on it. This keeps whatever background is set in shell.json
(change it from the menu: Style > Top Bar). Dragging widgets, clicks on
widgets and the menu all keep working.

Idempotent; re-applied after Omarchy updates by a pacman hook. If upstream
changed the hook point, the file is left alone. Undo: sudo pacman -S omarchy
"""
import sys
from pathlib import Path

PATH = Path(sys.argv[1] if len(sys.argv) > 1 else "/usr/share/omarchy/shell/plugins/bar/Bar.qml")
MARK = "// xmilon-bar-lock-patch"
OLD = """      if (mouse.button === Qt.LeftButton) {
        root.cycleBackground()
        mouse.accepted = true
      }"""
NEW = """      if (mouse.button === Qt.LeftButton) {
        """ + MARK + """: double-click no longer cycles the background
        mouse.accepted = true
      }"""

text = PATH.read_text()
if MARK in text:
    print("Bar background lock: already applied")
    sys.exit(0)
if text.count(OLD) != 1:
    print("Bar background lock: upstream changed; skipped")
    sys.exit(1)
PATH.write_text(text.replace(OLD, NEW))
print("Bar background lock: applied")
